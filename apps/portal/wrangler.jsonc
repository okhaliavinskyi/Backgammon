{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "onlineboard",
  "account_id": "e0e386d33a9be41c52eef1f4aedf6567",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "routes": [{ "pattern": "onlineboard.fun/*", "zone_name": "onlineboard.fun" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "services": [{ "binding": "NARDY", "service": "nardy" }],
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
