{
  "name": "nardy",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "worker"
  ],
  "scripts": {
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -w @nardy/core",
    "build": "npm run build -w @nardy/web",
    "dev:web": "npm run dev -w @nardy/web",
    "dev:worker": "npm run dev -w @nardy/worker",
    "deploy": "npm run build && npm run deploy -w @nardy/worker"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "typescript": "~5.9.3"
  }
}
